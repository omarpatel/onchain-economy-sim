# Copy to .env.local. All NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Tick server (packages/server) HTTP origin; the WebSocket is derived as ws(s)://…/ws.
# /play goes online when GET /api/health answers within 1.5 s, else it falls back to the in-browser sandbox.
# Also used server-side by app/api/economy (landing feed proxy).
NEXT_PUBLIC_ECON_SERVER=http://localhost:8788

# Settlement worker proofs API (packages/integration): GET /proofs/:epoch/:pubkey feeds the Chain tab claim list.
NEXT_PUBLIC_PROOFS_URL=http://localhost:8790

# Solana JSON-RPC for the wallet adapter and the dividends claim transaction (devnet by default).
NEXT_PUBLIC_RPC=https://api.devnet.solana.com

# $ECON SPL mint the dividends distributor was initialised with (packages/integration ECON_MINT).
# Shown in the Chain tab and used to derive the claim PDAs when a proof does not carry its own mint.
NEXT_PUBLIC_ECON_MINT=

# Public origin of this web app (e.g. https://econ-sim.example); makes the landing's Open Graph image URL absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
